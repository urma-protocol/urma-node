_urma_service() {
    /usr/bin/urma-node service "$@"
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
        echo "urma-node: service $1 failed ($rc)" >&2
    fi
}

post_install() {
    _urma_service install
}

post_upgrade() {
    _urma_service install
}

pre_remove() {
    _urma_service uninstall
}
