#!/bin/sh
set -e

# The binaries are already gone at purge, so this mirrors `service uninstall --purge`.
if [ "$1" = purge ]; then
    rm -rf /etc/urma-node /var/lib/urma-node /var/log/urma-node
    entry=$(getent passwd urma-node || true)
    uid=$(echo "$entry" | cut -d: -f3)
    home=$(echo "$entry" | cut -d: -f6)
    if [ -n "$uid" ] && [ "$uid" -lt 1000 ] && [ "$home" = /var/lib/urma-node ]; then
        userdel urma-node || true
    fi
    gid=$(getent group urma-node | cut -d: -f3 || true)
    if [ -n "$gid" ] && [ "$gid" -lt 1000 ]; then
        groupdel urma-node || true
    fi
fi

exit 0
